                    <li><a href="#f15">Library & Digital Resource Center</a></li>
                    <li><a href="#f16">Residential Boarding House</a></li>
                </ul>
            </div>
        </div>

        <div style="border-top: 1px solid var(--border-color); padding-top: 24px; display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted); flex-wrap: wrap; gap: 12px;">
            <p>&copy; 2026 Apex Academy. All rights reserved.</p>
            <p>Admissions Portal v3.4 | Designed with Modern CSS & Media Queries</p>
        </div>
    </footer>

