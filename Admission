                </ul>
            </div>

            <div class="footer-col">
                <h4>Class Academics</h4>
                <ul class="quick-links">
                    <li><a href="#f5">Class 5–8 Curriculum</a></li>
                    <li><a href="#f6">Class 9–10 Board Prep</a></li>
                    <li><a href="#f7">Class 11–12 Science Track</a></li>
                    <li><a href="#f8">Class 11–12 Commerce Track</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Rules & Guidelines</h4>
                <ul class="quick-links">
                    <li><a href="#f9">Code of Conduct</a></li>
                    <li><a href="#f10">Uniform & Dress Code</a></li>
                    <li><a href="#f11">Medical & Health Forms</a></li>
                    <li><a href="#f12">Withdrawal Policy</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Apex Academy Campus</h4>
                <ul class="quick-links">
                    <li><a href="#f13">Science & Robotics Labs</a></li>
